{
  // partner.ntagz.com: the partner portal (static build) + /api/v1. Shares the production D1 with the other Workers.
  // Deploy: `npm --prefix apps/partner-portal ci && npm --prefix apps/partner-portal run build`, then `npx wrangler deploy -c workers/partner/wrangler.jsonc`.
  // Secrets (never committed): PAN_HASH_SECRET (required), RESEND_API_KEY (sign-in codes + emails). Optional vars: HQ_NOTIFY_EMAILS, PARTNER_URL, ADMIN_URL.
  // Bucket `ntagz-kyc` is PRIVATE: no r2.dev URL, no custom domain. Never enable either.
  "name": "ntagz-partner",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "routes": [{ "pattern": "partner.ntagz.com", "custom_domain": true }],
  "assets": {
    "directory": "../../apps/partner-portal/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "ntagz-db", "database_id": "51216708-c501-49ce-a068-5b8854893e74" }],
  "r2_buckets": [{ "binding": "KYC", "bucket_name": "ntagz-kyc" }]
}
